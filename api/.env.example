# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional absolute path; defaults to api/data/events.sqlite.
# DB_STORAGE=/var/data/events.sqlite
# Production: use the Supabase session pooler PostgreSQL URL from Connect.
# DATABASE_URL=postgresql://postgres.project:password@pooler-host:5432/postgres
# Optional Supabase CA certificate (PEM) if required by its TLS certificate chain.
# DATABASE_CA_CERT=
SEED_DEMO=true
CACHE_TTL_MS=30000
MAIL_POLL_MS=5000
# URL-encode special characters in SMTP credentials. Keep real values out of Git.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# Render Free + Brevo: use the SMTP login and SMTP key, not an API key.
# SMTP_URL=smtp://encoded-login:encoded-smtp-key@smtp-relay.brevo.com:2525?requireTLS=true
MAIL_FROM=Campus Events <events@localhost>
# HTTPS delivery for hosts that block SMTP ports (for example Render Free).
# RESEND_API_KEY=re_replace_me
